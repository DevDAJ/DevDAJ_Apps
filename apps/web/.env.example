PORT=3001
# Comma-separated browser origins allowed by CORS (mobile apps don't need this).
API_CORS_ORIGINS=""

# Shared DevDAJ Supabase project: one login for every app (see packages/auth)
SUPABASE_URL="https://project.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="service_role_..."

# Shared AI provider keys (any app may use them)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""

# --- Fitnexx -------------------------------------------------------------
# Guests (Supabase anonymous users) may use member routes like food analysis. Pro always needs an account.
FITNEXX_ALLOW_GUESTS="true"
# Comma-separated provider:model pairs enabled for Pro. Defaults to each provider's recommended model.
FITNEXX_AI_MODELS="openai:gpt-4.1-mini,anthropic:claude-sonnet-4-20250514,google:gemini-2.5-flash,openrouter:openai/gpt-4.1-mini"
# Food photo analysis: LangChain pipeline uses OpenRouter for both steps.
# Vision identifies and weighs components; nutrition profiles components not found in the cache.
FITNEXX_USDA_API_KEY=""
FITNEXX_FOOD_VISION_MODEL="google/gemini-2.5-flash"
FITNEXX_FOOD_NUTRITION_MODEL="openai/gpt-4.1-mini"
FITNEXX_REVENUECAT_WEBHOOK_SECRET="change-me"
FITNEXX_REVENUECAT_SECRET_API_KEY="sk_..."
FITNEXX_REVENUECAT_PRO_ENTITLEMENT="pro"

# --- Web (browser) -------------------------------------------------------
# Same shared Supabase project; exposed to the browser for sign-in.
VITE_SUPABASE_URL="https://project.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# --- Admin dashboard ------------------------------------------------------
# Comma-separated Supabase user ids that may open /admin.
ADMIN_USER_IDS=""
# Local development only: skip admin sign-in under `vp dev` (compiled out of production builds).
VITE_ADMIN_DEV_BYPASS="false"
# Optional: a real Supabase user id the bypass acts as, needed to approve or reject contributions.
ADMIN_DEV_USER_ID=""

# Google Play installs (Play Console → Download reports → Statistics → Copy Cloud Storage URI).
# The service account must be invited in Play Console with "View app information and download bulk reports".
GOOGLE_PLAY_REPORTS_BUCKET="pubsite_prod_rev_0123456789"
# Service account key JSON, raw or base64.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""

# App Store Connect Sales reports (Users and Access → Integrations → App Store Connect API, "Sales" or "Finance" role).
APP_STORE_CONNECT_ISSUER_ID=""
APP_STORE_CONNECT_KEY_ID=""
# Contents of the .p8 key; literal \n is fine.
APP_STORE_CONNECT_PRIVATE_KEY=""
# Payments and Financial Reports → vendor number (top left).
APP_STORE_CONNECT_VENDOR_NUMBER=""
